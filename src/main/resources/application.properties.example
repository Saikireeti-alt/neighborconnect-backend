spring.application.name=neighborconnect-backend
server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/neighborconnect?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=your_db_user
spring.datasource.password=your_password_here

spring.jpa.hibernate.ddl-auto=update

server.error.include-message=always
spring.jpa.open-in-view=true